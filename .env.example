# Copy this file to .env (same folder) and fill in your values.
# .env is gitignored, so your keys never go to GitHub.

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# From Telegram's @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat id. Leave blank, run the bot, send it /start, and it replies with the number.
TELEGRAM_CHAT_ID=
